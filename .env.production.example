# Salin menjadi .env.production lalu isi semua nilai. Jangan di-commit.
DOMAIN=belajar.contoh.id
WEB_ORIGIN=https://belajar.contoh.id
NODE_ENV=production
COOKIE_SECURE=true

# Rahasia: buat dengan  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Admin dibuat saat seed pertama. Beri tanda kutip bila kata sandi memuat #.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (login kode dan lupa kata sandi). Kosongkan SMTP_HOST bila belum ada; fitur itu otomatis nonaktif.
MAIL_FROM=Mahir Excel <no-reply@contoh.id>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Premium lewat QRIS Xendit. Kosongkan kunci untuk memakai aktivasi manual saja.
PREMIUM_PRICE_LABEL=Rp 29.000 untuk 12 bulan
PREMIUM_PRICE_IDR=29000
PREMIUM_MONTHS=12
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Kontak pengelola. PREMIUM_CONTACT_URL untuk tombol di halaman Premium (pesan berisi email akun diisi otomatis);
# VITE_CONTACT_URL untuk tautan kontak di footer dan halaman Tentang (tertanam saat build).
PREMIUM_CONTACT_URL=
VITE_CONTACT_URL=

# --- Program Perintis: sertifikat gratis untuk pengguna pertama yang memenuhi syarat ---
# Syarat: tes penempatan, satu ronde Sprint, dan PROGRAM_MIN_EXERCISES latihan, semuanya saat masuk akun.
PROGRAM_ENABLED=true
PROGRAM_QUOTA=100
PROGRAM_MIN_EXERCISES=5

# Salin menjadi .env lalu sesuaikan. JANGAN commit .env.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# MySQL 8 (nilai bawaan cocok dengan docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=excellab
DB_PASSWORD=excellab_dev
DB_NAME=excellab

# Rahasia penanda sesi: minimal 32 karakter acak. Contoh membuatnya:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
COOKIE_SECURE=false

# Akun admin pengembangan dibuat oleh `npm run db:seed` HANYA jika kedua nilai ini diisi.
# Di produksi gunakan kata sandi unik yang kuat dan jangan simpan di repositori.
ADMIN_EMAIL=
# Beri tanda kutip bila kata sandi memuat karakter # (di .env, # dianggap komentar): ADMIN_PASSWORD="abc#123"
ADMIN_PASSWORD=

# Email (untuk login kode dan atur ulang kata sandi).
# Kosong di pengembangan: kode dicetak di terminal API. Di produksi isi SMTP_HOST agar email benar-benar terkirim;
# tanpa SMTP di produksi, fitur email dimatikan otomatis.
MAIL_FROM=Mahir Excel <no-reply@contoh.id>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Folder file worksheet (.xlsx). Kosong = apps/api/storage/worksheets
WORKSHEET_DIR=

# Tautan kontak di footer web (opsional)
VITE_CONTACT_URL=

# --- Login dengan Google (opsional) ---
# Buat "OAuth client ID" jenis Web di https://console.cloud.google.com/apis/credentials
# lalu isi "Authorized JavaScript origins" dengan alamat webmu (mis. http://localhost:5173 dan https://domainmu.id).
# Kosongkan bila tidak dipakai; tombol Google otomatis tidak tampil.
GOOGLE_CLIENT_ID=

# --- Sprint ---
# Lama satu ronde adu cepat dalam detik (5 sampai 180, bawaan 60).
SPRINT_SECONDS=60

# --- Premium (aktivasi manual oleh admin lewat /admin/pengguna) ---
# Label harga yang ditampilkan di halaman /premium (contoh; ubah sesuai harga yang kamu tetapkan).
PREMIUM_PRICE_LABEL=Rp 29.000 untuk 12 bulan
# Tautan kontak pembayaran, mis. https://wa.me/62812xxxxxxx (pesan berisi email akun diisi otomatis).
PREMIUM_CONTACT_URL=
